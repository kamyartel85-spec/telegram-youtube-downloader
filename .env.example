# ── Required ──────────────────────────────────────────────
# Get these from https://my.telegram.org  (API Development Tools)
BOT_TOKEN=123456:your_bot_token_here
API_ID=123456
API_HASH=your_api_hash_here

# ── Optional ──────────────────────────────────────────────
# Directory for temporary downloads (default: /tmp/ytdl_downloads)
DOWNLOAD_DIR=/tmp/ytdl_downloads

# Max upload size in bytes (default: 2 GiB — the MTProto bot limit)
MAX_FILE_SIZE=2147483648

# Per-user concurrent downloads (default: 1)
MAX_CONCURRENT_DOWNLOADS=1

# Timeouts in seconds (defaults: 600 download, 1800 upload)
DOWNLOAD_TIMEOUT=600
UPLOAD_TIMEOUT=1800

# Health-check port (Railway sets PORT automatically)
HEALTH_CHECK_PORT=8000

# Telethon session file name (default: bot_session)
SESSION_NAME=bot_session

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SQLite database path (default: /tmp/ytdl_bot/bot.db)
DB_PATH=/tmp/ytdl_bot/bot.db

# Telegram user ID of the bot owner (becomes 'owner' admin automatically)
# Find your numeric ID by messaging @userinfobot on Telegram
OWNER_ID=0

# Support contact (Telegram username or t.me link, shown to users)
SUPPORT_ID=

# Information channel link (shown to users in the channel menu button)
CHANNEL_LINK=

# Maximum number of playlist items to fetch/download in one request (default: 25)
MAX_PLAYLIST_ITEMS=25

# Rate limit: max incoming messages per user per minute (default: 5)
RATE_LIMIT_PER_MINUTE=5

# Default daily downloads limit per user (default: 10)
DEFAULT_DAILY_LIMIT=10

# Default bonus downloads granted for referring a new user (default: 3)
DEFAULT_REFERRAL_BONUS=3

# Telegram Channel ID to forward completed downloads to (e.g. -1001234567890)
DOWNLOAD_LOG_CHANNEL_ID=

# Telegram Channel ID to forward critical error logs and reports to (e.g. -1001234567890)
ERROR_LOG_CHANNEL_ID=

