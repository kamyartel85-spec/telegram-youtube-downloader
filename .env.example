# ── Required ──────────────────────────────────────────────
# Get these from https://my.telegram.org  (API Development Tools)
BOT_TOKEN=123456:your_bot_token_here
API_ID=123456
API_HASH=your_api_hash_here

# ── Optional ──────────────────────────────────────────────
# Directory for temporary downloads (default: /tmp/ytdl_downloads)
DOWNLOAD_DIR=/tmp/ytdl_downloads

# Max upload size in bytes (default: 2 GiB — the MTProto bot limit)
MAX_FILE_SIZE=2147483648

# Per-user concurrent downloads (default: 1)
MAX_CONCURRENT_DOWNLOADS=1

# Timeouts in seconds (defaults: 600 download, 1800 upload)
DOWNLOAD_TIMEOUT=600
UPLOAD_TIMEOUT=1800

# Health-check port (Railway sets PORT automatically)
HEALTH_CHECK_PORT=8000

# Telethon session file name (default: bot_session)
SESSION_NAME=bot_session

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
